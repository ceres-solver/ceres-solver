      "side": 1,
      "message": "Refactor CoordinateDescentMinimizerTest so that SetParameterOffsetsAndIndex() is called before minimizer_.Init(...), state_ is populated automatically from the program\u0027s parameter blocks via ParameterBlocksToStateVector, and metadata_ and minimizer_ are stored as fixture members:\n\nclass CoordinateDescentMinimizerTest : public ::testing::Test {\n protected:\n  bool InitMinimizer(const ParameterBlockOrdering\u0026 ordering) {\n    problem_.mutable_program()-\u003eSetParameterOffsetsAndIndex();\n    state_.resize(problem_.program().NumParameters());\n    problem_.program().ParameterBlocksToStateVector(state_.data());\n    initial_state_ \u003d state_;\n    metadata_.clear();\n    for (ParameterBlock* block : problem_.program().parameter_blocks()) {\n      metadata_.push_back({block-\u003eindex(),\n                           block-\u003estate_offset(),\n                           block-\u003edelta_offset(),\n                           block-\u003eIsConstant()});\n    }\n    return minimizer_.Init(\n        problem_.program(), problem_.parameter_map(), ordering, \u0026error_);\n  }\n\n  void ResetState() { state_ \u003d initial_state_; }\n\n  void Minimize(int num_threads \u003d 1) {\n    Minimizer::Options options;\n    options.num_threads \u003d num_threads;\n    problem_.context()-\u003eEnsureMinimumThreads(num_threads);\n    Solver::Summary summary;\n    minimizer_.Minimize(options, state_.data(), \u0026summary);\n  }\n\n  double x_ \u003d 0.0;\n  double y_ \u003d 0.0;\n  double z_ \u003d 0.0;\n  std::vector\u003cdouble\u003e state_;\n  std::vector\u003cdouble\u003e initial_state_;\n  std::vector\u003cBlockMetadata\u003e metadata_;\n  std::string error_;\n  ProblemImpl problem_;\n  CoordinateDescentMinimizer minimizer_{problem_.context()};\n};",
