      "side": 1,
      "message": "okay reading this code more carefully, you have one implementation for AccurateNorm(x,y) but a completely different implementation for AccurateNorm(x,y,z,...)?",
      "revId": "a77108b6b3c24eed2d717cb4978439d27f8e9b03",
